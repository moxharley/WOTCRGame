.border-margin {
    margin-top: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    margin-left: 16px;
}

.healthbar-size {
    width: 33%;
    height: 100%;
}

.healthbar-change-transition {
    transition-property: width;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out-sine;
}

.pouch-size {
    width: 11%;
    height: 100%;
}

.pouch-text {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: flex-end;
    justify-content: flex-end;
    align-self: center;
    align-content: flex-end;
    -unity-font-definition: url("project://database/Assets/Fonts/dungeon-mode.ttf?fileID=12800000&guid=3b81bb6f6bd56f746b29f780d25a9846&type=3#dungeon-mode");
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 33%;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-direction: column;
    height: 5%;
    width: 100%;
}

.healthbar-text {
    position: absolute;
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: flex-start;
    -unity-font-definition: url("project://database/Assets/Fonts/dungeon-mode.ttf?fileID=12800000&guid=3b81bb6f6bd56f746b29f780d25a9846&type=3#dungeon-mode");
    -unity-text-align: upper-center;
    margin-top: 8%;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-shrink: 0;
    text-overflow: ellipsis;
    width: 100%;
    height: 5%;
    color: rgb(255, 255, 255);
}
